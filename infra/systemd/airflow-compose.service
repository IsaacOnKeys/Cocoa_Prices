# Captured 2026-10-26; environment values omitted if present.
[Unit]
Description=Airflow via Docker Compose with Fernet key from Secret Manager
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/airflow
ExecStart=/usr/bin/bash -c 'AIRFLOW__CORE__FERNET_KEY=$(gcloud secrets versions access latest --secret=airflow-fernet-key --project=cocoa-prices-430315) docker compose up -d'
ExecStop=/usr/bin/docker compose down
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
