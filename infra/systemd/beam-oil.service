# Captured 2026-10-26; environment values omitted if present.
[Unit]
Description=Beam Oil stream (Pub/Sub -> BigQuery)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=beam
Group=beam
WorkingDirectory=/opt/beam/oil
EnvironmentFile=/opt/beam/.env
TimeoutStopSec=60
ExecStart=/opt/beam/venv/bin/python /opt/beam/oil/local_oil_stream.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
